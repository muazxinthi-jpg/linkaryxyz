{
  "name": "linkaryxyz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "app:dev": "vite --config frontend/vite.config.ts",
    "app:check": "tsc -p frontend/tsconfig.json --noEmit",
    "app:build": "vite build --config frontend/vite.config.ts",
    "check": "npm run app:check && npm run deploy:dry",
    "deploy": "npm run app:build && wrangler deploy",
    "deploy:dry": "npm run app:build && wrangler deploy --dry-run",
    "types": "wrangler types"
  },
  "dependencies": {
    "@coinbase/cdp-core": "0.0.123",
    "@coinbase/cdp-hooks": "0.0.123",
    "@coinbase/cdp-react": "0.0.123",
    "@coinbase/cdp-sdk": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "wrangler": "^4.88.0"
  }
}
